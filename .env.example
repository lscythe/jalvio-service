# Copy to .env and fill in the upstream endpoints for your deployment.

# Required: the static GTFS feed (zip).
GTFS_URL=https://gtfs.example.com/feed.zip
GTFS_REFRESH=24h

# Live bus positions; leave MQTT_URL empty to turn the live feed off.
MQTT_URL=
MQTT_TLS_SERVER_NAME=
MQTT_DIAL_ADDRESS=

# Daily stop facilities sync; leave STOP_API_URL empty to turn it off.
STOP_API_URL=
STOP_API_APP_VERSION=
STOPINFO_SYNC_AT=03:00

# Time zone for STOPINFO_SYNC_AT.
TZ=UTC

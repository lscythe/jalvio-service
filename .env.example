# Copy to .env and fill in the upstream endpoints for your deployment.

# Required: the static GTFS feed (zip).
GTFS_URL=https://gtfs.example.com/feed.zip
GTFS_REFRESH=24h

# Live bus positions; leave MQTT_URL empty to turn the live feed off.
MQTT_URL=
MQTT_TLS_SERVER_NAME=
MQTT_DIAL_ADDRESS=
# Some brokers only accept client IDs with a given prefix; default jalvio-.
MQTT_CLIENT_ID_PREFIX=

# Daily stop facilities sync; leave STOP_API_URL empty to turn it off.
STOP_API_URL=
STOP_API_APP_VERSION=
STOPINFO_SYNC_AT=03:00

# Place search; leave PHOTON_URL empty to turn it off. Public instances ask
# for a User-Agent that names the operator and a contact.
PHOTON_URL=
PHOTON_USER_AGENT=
PLACES_REQUESTS_PER_MINUTE=60

# Live stream (/v1/live) limits. Native apps send no Origin; list the web
# origins, space-separated, that may connect from a browser.
MAX_LIVE_CONNECTIONS=2000
BROWSER_ORIGINS=

# Time zone for STOPINFO_SYNC_AT.
TZ=UTC

# Copy to .env and fill in the settings for your deployment.

# Required: the regions served and each one's upstreams, starting from
# regions.example.json. Empty means regions.json in JALVIO_DATA_DIR; compose.yaml
# mounts ./regions.json instead and ignores this setting.
REGIONS_FILE=

# Place search, shared by every region; leave PHOTON_URL empty to turn it off.
# Public instances ask for a User-Agent that names the operator and a contact.
PHOTON_URL=
PHOTON_USER_AGENT=
PLACES_REQUESTS_PER_MINUTE=60

# Live stream limits across every region. Native apps send no Origin; list the
# web origins, space-separated, that may connect from a browser.
MAX_LIVE_CONNECTIONS=2000
BROWSER_ORIGINS=

# Terms and privacy policy to publish, starting from legal.example.json.
# Empty means legal.json in JALVIO_DATA_DIR; without the file, none are published.
LEGAL_FILE=
